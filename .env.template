# Salin file ini menjadi .env, lalu isi semua nilai placeholder.
# Jangan commit atau mengirim .env yang berisi secret.

POSTGRES_USER=ascit_app
POSTGRES_PASSWORD=ganti-dengan-password-postgres-kuat
POSTGRES_DB=ascit_db

DATABASE_URL=postgresql://ascit_app:ganti-dengan-password-postgres-kuat@ascit-db:5432/ascit_db?schema=public
NEXTAUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
NEXTAUTH_URL=https://domain-ascit-anda.example

SEED_ADMIN_PASSWORD=ganti-password-admin-kuat
SEED_STAF_PASSWORD=ganti-password-staf-kuat
SEED_KEPALA_PASSWORD=ganti-password-kepala-kuat
SEED_MANAJEMEN_PASSWORD=ganti-password-manajemen-kuat

OLLAMA_BASE_URL=http://ollama:11434/api
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_MAX_TOKENS=512
OLLAMA_MAX_OUTPUT_TOKENS=512
OLLAMA_TIMEOUT_MS=90000
AI_WORKER_CONCURRENCY=1
AI_WORKER_POLL_MS=1000

# Fitur berisiko tinggi dinonaktifkan secara default. Aktifkan sementara hanya saat dibutuhkan.
ALLOW_WEB_DATABASE_CLEAR=false
ALLOW_WEB_SQL_RESTORE=false
